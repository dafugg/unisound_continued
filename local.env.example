# Copy to local.env and adjust.
# 86box-mcp checkout (github.com/dafugg/86box-mcp) with its server venv in server/.venv
BOX86MCP=$HOME/86box-mcp
# 86Box VM directory: MS-DOS with Turbo C++ 3.0 installed as C:\TC
# (C:\TC\BIN\TURBOC.CFG: -IC:\TC\INCLUDE -LC:\TC\LIB)
UNIVM=$HOME/vms/tc30
# Optional: directory holding mtools binaries, if they are not on PATH
#MTOOLS_DIR=$HOME/mtools/usr/bin
# Optional: Python with capstone, for objmatch/fn/funcmap (default python3)
#PYTHON=$HOME/venv/bin/python
# Optional: the original UNISOUND.COM v0.82a (default orig/UNISOUND.COM)
#UNISOUND_COM=$HOME/unisound/UNISOUND.COM
# Optional: 86Box ROM set (a clone of github.com/86Box/roms); otherwise 86Box's default folders
#BOX86_ROMS=$HOME/86box-roms
